# Copy values into Render/Railway/VPS secrets — never commit real secrets.
NODE_ENV=production
PORT=8080
TRUST_PROXY=1
COOKIE_SECURE=1

# From Neon / Render Postgres / Supabase (must include sslmode=require for most hosts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# If the Docker/Render service serves landing + API on ONE host, use that same origin:
FRONTEND_ORIGIN="https://filfilu-hms.onrender.com"
CORS_ORIGIN="https://filfilu-hms.onrender.com"

# If you keep the Vercel brochure separate and call this API from it, also allow:
# CORS_ORIGIN="https://filfilu-hms.vercel.app,https://filfilu-hms.onrender.com"
# FRONTEND_ORIGIN="https://filfilu-hms.vercel.app"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://filfilu-hms.onrender.com/api/auth/google/callback"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Filfilu HMS <noreply@example.com>"
