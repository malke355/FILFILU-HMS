# SQLite (no Docker). For Postgres: docker compose up -d and use the URL below instead.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://filfilu:filfilu@127.0.0.1:5432/filfilu?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# App + API share this port. GOOGLE_REDIRECT_URI must use the SAME host:port.
PORT=8080
CORS_ORIGIN="http://127.0.0.1:8080,http://localhost:8080"
FRONTEND_ORIGIN="http://127.0.0.1:8080"
NODE_ENV=development

# Google OAuth / OpenID Connect (Web application client)
# Create credentials in Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must EXACTLY match an Authorized redirect URI for the client (same PORT as above):
#   http://127.0.0.1:8080/api/auth/google/callback
#   http://localhost:8080/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://127.0.0.1:8080/api/auth/google/callback"
# Seconds of allowed clock skew when verifying Google ID tokens (default 86400 = 24h)
# GOOGLE_CLOCK_TOLERANCE_SEC=86400
