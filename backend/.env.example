# PostgreSQL via Docker (filfilu-hms-pg). Never commit real .env values.
PGHOST=127.0.0.1
# Windows PostgreSQL often owns 5433 — Docker HMS uses 5434 bound to 127.0.0.1 only
PGPORT=5434
HMS_PG_PORT=5434
PGDATABASE=hms

# App DB role (least privilege — used by Express/Prisma). Not the postgres superuser.
PGUSER=filfilu
PGPASSWORD=REPLACE_WITH_LONG_RANDOM_APP_PASSWORD
DATABASE_URL="postgresql://filfilu:REPLACE_WITH_LONG_RANDOM_APP_PASSWORD@127.0.0.1:5434/hms?schema=public"

# Docker bootstrap only (superuser for container init / admin). Keep strong & private.
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SUPERUSER_PASSWORD

# Required — app will not start without a strong unique secret (≥32 chars, no placeholders).
# This example value is intentionally invalid (too short / denylisted). Generate your own.
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"
PORT=8080

# Local development origins (http). Production MUST set https origins explicitly (no localhost default).
CORS_ORIGIN="http://127.0.0.1:8080,http://localhost:8080"
FRONTEND_ORIGIN="http://127.0.0.1:8080"
NODE_ENV=development

# Cookies / proxy: auto-secure when NODE_ENV=production. Behind nginx TLS set both:
# COOKIE_SECURE=1
# TRUST_PROXY=1
# See docker/nginx/filfilu.conf and scripts/backup-db.(sh|ps1).

# Google OAuth — local callback (register the same URI in Google Cloud Console):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8080/api/auth/google/callback"
# Production example (also add Authorized redirect URI in Google Cloud Console):
# GOOGLE_REDIRECT_URI="https://your-domain.example/api/auth/google/callback"
# FRONTEND_ORIGIN="https://your-domain.example"
# CORS_ORIGIN="https://your-domain.example"
# Optional local-only clock drift workaround (max 300s in production; default 300):
# GOOGLE_CLOCK_TOLERANCE_SEC=300

# Data retention (days) — applied on API startup
AUDIT_RETENTION_DAYS=90
CONTACT_RETENTION_DAYS=180
BOOKING_RETENTION_DAYS=180

# SMTP (Nodemailer) — required in production for password-reset emails.
# Gmail: enable 2FA → App passwords → use the 16-char app password (spaces optional).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="your16characterapppassword"
SMTP_FROM="Filfilu HMS <yourgmail@gmail.com>"

# Local debug only: include reset URL in forgot-password JSON (never in production).
# ALLOW_DEV_RESET_URL=1
