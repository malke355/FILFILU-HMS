# Local Docker Postgres (see docker-compose.yml):
DATABASE_URL="postgresql://filfilu:filfilu@127.0.0.1:5432/filfilu?schema=public"
# SQLite alternative:
# DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173"
FRONTEND_ORIGIN="http://127.0.0.1:4000"
NODE_ENV=development

# Google OAuth / OpenID Connect (Web application client)
# Create credentials in Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must EXACTLY match an Authorized redirect URI registered for the client:
#   http://127.0.0.1:4000/api/auth/google/callback
#   http://localhost:4000/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://127.0.0.1:4000/api/auth/google/callback"
# Seconds of allowed clock skew when verifying Google ID tokens (default 86400 = 24h)
# GOOGLE_CLOCK_TOLERANCE_SEC=86400
