DATABASE_URL="file:./dev.db"
# For PostgreSQL later:
# DATABASE_URL="postgresql://user:pass@localhost:5432/filfilu?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173"
FRONTEND_ORIGIN="http://127.0.0.1:8080"
NODE_ENV=development

# Google OAuth / OpenID Connect (Web application client)
# Create credentials in Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match an Authorized redirect URI registered for the client:
GOOGLE_REDIRECT_URI="http://127.0.0.1:4000/api/auth/google/callback"
