# PostgreSQL — copy to .env and fill in your password (never commit .env)
PGHOST=localhost
# Use 5433 if free; if Windows PostgreSQL owns 5433, Docker uses 5434:
PGPORT=5434
PGDATABASE=hms
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5434/hms?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=8080
CORS_ORIGIN="http://127.0.0.1:8080,http://localhost:8080"
FRONTEND_ORIGIN="http://127.0.0.1:8080"
NODE_ENV=development

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:8080/api/auth/google/callback"
